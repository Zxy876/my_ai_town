limit_req_zone $binary_remote_addr zone=ai_town_deepseek_rate:10m rate=120r/m;
limit_conn_zone $binary_remote_addr zone=ai_town_deepseek_conn:10m;

map $uri $ai_town_asset_cache_control {
    default "public, max-age=3600";
    "~^/ai-town/index\.[0-9a-f]{16}\.(pck|wasm)$" "public, max-age=31536000, immutable";
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/maieutic-public;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /api/health {
        proxy_pass http://app:3000/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        return 301 https://43-128-24-238.sslip.io$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name 43-128-24-238.sslip.io;

    ssl_certificate /etc/letsencrypt/live/43-128-24-238.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/43-128-24-238.sslip.io/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 25m;
    keepalive_timeout 65s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml application/wasm image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /api/deepseek/chat/completions {
        limit_except POST { deny all; }
        limit_req zone=ai_town_deepseek_rate burst=40 nodelay;
        limit_conn ai_town_deepseek_conn 8;

        client_max_body_size 2m;
        proxy_pass https://api.deepseek.com/chat/completions;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host api.deepseek.com;
        proxy_set_header Authorization "Bearer __DEEPSEEK_API_KEY__";
        proxy_set_header Content-Type "application/json";
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location = /ai-town {
        return 302 /ai-town/;
    }

    location = /ai-town/index.html {
        alias /var/www/maieutic-public/ai-town/index.html;
        add_header Cache-Control "no-cache" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location ^~ /ai-town/ {
        alias /var/www/maieutic-public/ai-town/;
        index index.html;
        add_header Cache-Control $ai_town_asset_cache_control always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location /api/health {
        proxy_pass http://app:3000/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        alias /var/www/maieutic-uploads/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
