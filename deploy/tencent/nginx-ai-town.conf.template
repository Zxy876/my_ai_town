limit_req_zone $binary_remote_addr zone=ai_town_deepseek_rate:10m rate=120r/m;
limit_conn_zone $binary_remote_addr zone=ai_town_deepseek_conn:10m;

server {
    listen 80;
    server_name _;

    client_max_body_size 25m;
    keepalive_timeout 65s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml application/wasm image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /api/deepseek/chat/completions {
        limit_except POST { deny all; }
        limit_req zone=ai_town_deepseek_rate burst=40 nodelay;
        limit_conn ai_town_deepseek_conn 8;

        client_max_body_size 2m;
        proxy_pass https://api.deepseek.com/chat/completions;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host api.deepseek.com;
        proxy_set_header Authorization "Bearer __DEEPSEEK_API_KEY__";
        proxy_set_header Content-Type "application/json";
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location = /ai-town {
        return 302 /ai-town/;
    }

    location = /ai-town/index.html {
        alias /var/www/maieutic-public/ai-town/index.html;
        add_header Cache-Control "no-cache" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location ^~ /ai-town/ {
        alias /var/www/maieutic-public/ai-town/;
        index index.html;
        add_header Cache-Control "public, max-age=3600" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location /api/health {
        proxy_pass http://app:3000/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        alias /var/www/maieutic-uploads/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
