#!/bin/sh
set -eu

config=/opt/maieutic/nginx.conf
compose=/opt/maieutic/docker-compose.yml
backup_dir=/opt/maieutic/.deploy-backups

[ "$(id -u)" -eq 0 ]
test -s "$config"
test -s "$compose"
mkdir -p "$backup_dir"

backup="$backup_dir/nginx.conf-pre-ai-town-cache-$(date +%Y%m%d-%H%M%S)"
next=$(mktemp /opt/maieutic/.nginx-ai-town-cache.XXXXXX)
edited=$(mktemp /opt/maieutic/.nginx-ai-town-cache-edited.XXXXXX)
trap 'rm -f "$next" "$edited"' EXIT
cp -p "$config" "$backup"

old_location='location ^~ /ai-town/ {
        alias /var/www/maieutic-public/ai-town/;
        index index.html;
        add_header Cache-Control "public, max-age=3600" always;'
new_location='location ^~ /ai-town/ {
        alias /var/www/maieutic-public/ai-town/;
        index index.html;
        add_header Cache-Control $ai_town_asset_cache_control always;'

anchor='limit_conn_zone $binary_remote_addr zone=ai_town_deepseek_conn:10m;'

if grep -Fq "$new_location" "$backup" && \
   grep -Fq '~^/ai-town/index\\.[0-9a-f]{16}\\.audio(\\.position)?\\.worklet\\.js$' "$backup"; then
	cp -p "$backup" "$next"
else
	awk -v old_loc="$old_location" -v new_loc="$new_location" -v anchor="$anchor" '
		BEGIN { skipping_map = 0; did_print_map = 0 }
		{
			if (!skipping_map && match($0, /^[[:space:]]*map[[:space:]]+\$uri[[:space:]]+\$ai_town_asset_cache_control[[:space:]]*\{/)) {
				skipping_map = 1
				brace_balance = 1
				next
			}
			if (skipping_map) {
				n = split($0, ch, "")
				for (i = 1; i <= n; i++) {
					if (ch[i] == "{") brace_balance++
					else if (ch[i] == "}") {
						brace_balance--
						if (brace_balance <= 0) {
							skipping_map = 0
							next
						}
					}
				}
				next
			}
			if ($0 == anchor && !did_print_map) {
				print
				print ""
				print "map $uri $ai_town_asset_cache_control {"
				print "    default \"public, max-age=3600\";"
				print "    \"~^/ai-town/index\\.[0-9a-f]{16}\\.(pck|wasm)$\" \"public, max-age=31536000, immutable\";"
				print "    \"~^/ai-town/index\\.[0-9a-f]{16}\\.audio(\\.position)?\\.worklet\\.js$\" \"public, max-age=31536000, immutable\";"
				print "}"
				did_print_map = 1
				next
			}
			if (index($0, old_loc) > 0) {
				print new_loc
				next
			}
			print
		}
	' "$backup" > "$next"
fi

cp -p "$next" "$config"

docker compose -f "$compose" exec -T nginx nginx -t 2>&1 | head -5
if ! docker compose -f "$compose" exec -T nginx nginx -t >/dev/null 2>&1; then
	cp -p "$backup" "$config"
	docker compose -f "$compose" exec -T nginx nginx -t 2>&1 | head -20
	exit 1
fi

docker compose -f "$compose" exec -T nginx nginx -s reload
printf 'AI_TOWN_NGINX_CACHE=installed\n'
