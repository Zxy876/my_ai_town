#!/bin/sh
set -eu

config=/opt/maieutic/nginx.conf
compose=/opt/maieutic/docker-compose.yml
backup_dir=/opt/maieutic/.deploy-backups

[ "$(id -u)" -eq 0 ]
test -s "$config"
test -s "$compose"
mkdir -p "$backup_dir"

backup="$backup_dir/nginx.conf-pre-ai-town-cache-$(date +%Y%m%d-%H%M%S)"
next=$(mktemp /opt/maieutic/.nginx-ai-town-cache.XXXXXX)
trap 'rm -f "$next"' EXIT
cp -p "$config" "$backup"

worklet_loc_regex_audio='location ~* ^/ai-town/index\.[0-9a-f]{16}\.audio\.worklet\.js$ {'
worklet_loc_regex_position='location ~* ^/ai-town/index\.[0-9a-f]{16}\.audio\.position\.worklet\.js$ {'
worklet_pat_map_audio='~^/ai-town/index\.[0-9a-f]{16}\.audio\.worklet\.js$'
worklet_pat_map_position='~^/ai-town/index\.[0-9a-f]{16}\.audio\.position\.worklet\.js$'
worklet_pat_any='~^/ai-town/index\.[0-9a-f]{16}\.audio'
pck_wasm_pat='~^/ai-town/index\.[0-9a-f]{16}\.(pck|wasm)$'
map_header_regex='^[[:space:]]*map[[:space:]]+\$uri[[:space:]]+\$ai_town_asset_cache_control[[:space:]]*\{'
ai_town_prefix_loc_regex='^[[:space:]]*location[[:space:]]+\^~[[:space:]]+/ai-town/[[:space:]]*\{'
anchor='limit_conn_zone $binary_remote_addr zone=ai_town_deepseek_conn:10m;'

loc_audio_block="${worklet_loc_regex_audio}
        root /var/www/maieutic-public;
        add_header Cache-Control \"public, max-age=31536000, immutable\" always;
        add_header Cross-Origin-Opener-Policy \"same-origin\" always;
        add_header Cross-Origin-Embedder-Policy \"require-corp\" always;
        add_header Cross-Origin-Resource-Policy \"same-origin\" always;
        try_files \$uri =404;
    }"
loc_position_block="${worklet_loc_regex_position}
        root /var/www/maieutic-public;
        add_header Cache-Control \"public, max-age=31536000, immutable\" always;
        add_header Cross-Origin-Opener-Policy \"same-origin\" always;
        add_header Cross-Origin-Embedder-Policy \"require-corp\" always;
        add_header Cross-Origin-Resource-Policy \"same-origin\" always;
        try_files \$uri =404;
    }"

fresh_map_block='map $uri $ai_town_asset_cache_control {
    default "public, max-age=3600";
    "'"$pck_wasm_pat"'" "public, max-age=31536000, immutable";
    "'"$worklet_pat_map_audio"'" "public, max-age=31536000, immutable";
    "'"$worklet_pat_map_position"'" "public, max-age=31536000, immutable";
}'

if grep -Eq "$map_header_regex" "$backup" && \
   grep -Fq "$worklet_pat_any" "$backup" && \
   grep -Fq "$worklet_loc_regex_audio" "$backup" && \
   grep -Fq "$worklet_loc_regex_position" "$backup"; then
	cp -p "$backup" "$next"
else
	awk -v anchor="$anchor" \
	    -v fresh_map="$fresh_map_block" \
	    -v map_header_re="$map_header_regex" \
	    -v ai_town_loc_re="$ai_town_prefix_loc_regex" \
	    -v loc_audio="$loc_audio_block" \
	    -v loc_pos="$loc_position_block" '
		BEGIN {
			skipping_map = 0
			did_print_map = 0
			did_insert_worklet_locs = 0
		}
		{
			if (!skipping_map && $0 ~ map_header_re) {
				skipping_map = 1
				brace_balance = 1
				next
			}
			if (skipping_map) {
				n = split($0, ch, "")
				for (i = 1; i <= n; i++) {
					if (ch[i] == "{") brace_balance++
					else if (ch[i] == "}") {
						brace_balance--
						if (brace_balance <= 0) { skipping_map = 0; next }
					}
				}
				next
			}
			if ($0 == anchor && !did_print_map) {
				print
				print ""
				print fresh_map
				did_print_map = 1
				next
			}
			if ($0 ~ ai_town_loc_re && !did_insert_worklet_locs) {
				print ""
				print "    " loc_audio
				print ""
				print "    " loc_pos
				print ""
				print
				did_insert_worklet_locs = 1
				next
			}
			print
		}
	' "$backup" > "$next"
fi

cp -p "$next" "$config"

docker compose -f "$compose" exec -T nginx nginx -t 2>&1 | head -5
if ! docker compose -f "$compose" exec -T nginx nginx -t >/dev/null 2>&1; then
	cp -p "$backup" "$config"
	docker compose -f "$compose" exec -T nginx nginx -t 2>&1 | head -20
	exit 1
fi

docker compose -f "$compose" exec -T nginx nginx -s reload
printf 'AI_TOWN_NGINX_CACHE=installed\n'
